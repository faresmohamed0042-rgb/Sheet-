rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /returns/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.unit is string
        && request.resource.data.leave is string
        && request.resource.data.days is int && request.resource.data.days > 0 && request.resource.data.days <= 365
        && request.resource.data.count is int && request.resource.data.count > 0 && request.resource.data.count <= 5000;
    }
  }
}
